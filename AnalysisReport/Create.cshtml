@model CreateAnalysisReportDto


@{
    ViewData["Title"] = "Ante Mortem Muayene Formu";
}

<style>
    /* A4 Boyutlandırma ve Yazdırma Ayarları */
    :root {
        --a4-width: 210mm;
        --a4-height: 297mm;
    }

    body {
        background-color: #f4f7f6;
    }

    .form-container {
        width: var(--a4-width);
        min-height: var(--a4-height);
        margin: 20px auto;
        background-color: #fff;
        border: 1px solid #d3d3d3;
        border-radius: 8px;
        padding: 15mm; /* A4 standart kenar boşluğu */
        box-shadow: 0 0 10px rgba(0,0,0,0.1);
        position: relative;
    }

    /* Yazdırma Esnasında Gereksiz Alanları Gizle */
    @@media print {
        body {
            background: none;
            margin: 0;
            padding: 0;
        }

        .form-container {
            margin: 0;
            border: none;
            box-shadow: none;
            width: 100%;
            padding: 10mm;
        }

        .d-print-none {
            display: none !important;
        }

        .container {
            max-width: 100% !important;
            width: 100% !important;
        }
    }

    /* Başlık Bölümü */
    .header-section {
        border-bottom: 2px solid #333;
        margin-bottom: 15px;
        padding-bottom: 10px;
    }

    /* Etiket ve Input Stilleri */
    .custom-label {
        font-size: 0.65rem;
        font-weight: 800;
        color: #2c3e50;
        text-transform: uppercase;
        margin-bottom: 2px;
        display: block;
        letter-spacing: 0.3px;
    }

    .custom-input {
        border: 1px solid #bdc3c7;
        border-radius: 4px;
        padding: 4px 8px;
        font-size: 0.8rem;
        height: 32px;
    }

    /* Bölüm Başlıkları */
    .section-title {
        font-size: 0.85rem;
        font-weight: 800;
        color: #2c3e50;
        border-bottom: 1px solid #eee;
        padding-bottom: 5px;
        margin-bottom: 15px;
        display: flex;
        align-items: center;
        text-transform: uppercase;
    }

    /* Mikro Bilgi Metinleri */
    .micro-text {
        font-size: 0.6rem;
        font-weight: 700;
        color: #7f8c8d;
        line-height: 1.2;
    }

    /* Analiz Tablosu */
    .analysis-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.75rem;
    }

    .analysis-table thead th {
        background-color: #f8f9fa;
        color: #2c3e50;
        font-weight: 800;
        padding: 8px 4px;
        border: 1px solid #dee2e6;
        text-align: center;
    }

    .analysis-table tbody td {
        padding: 6px 4px;
        vertical-align: middle;
        border: 1px solid #dee2e6;
    }

    .analysis-table .form-check-input {
        width: 1.1rem;
        height: 1.1rem;
        margin: 0;
    }

    .fw-bold {
        font-weight: 700 !important;
    }

    .uppercase {
        text-transform: uppercase;
    }
</style>

<form id="analysisForm"
       action="/AnalysisReport/Create"
       method="post">

@Html.AntiForgeryToken()

    <div class="container d-print-none mt-3">
        <div class="d-flex justify-content-between">
            <a asp-controller="AnalysisReport" asp-action="Index" class="btn btn-sm btn-outline-secondary px-4 rounded-pill">
                <i class="bi bi-arrow-left me-2"></i>Listeye Dön
            </a>
            <button type="button" onclick="window.print()" class="btn btn-sm btn-outline-dark px-4 rounded-pill">
                <i class="bi bi-printer me-2"></i>Yazdır
            </button>
        </div>
    </div>

    <div class="form-container">
        <!-- Başlık ve Logo Alanı -->
        <div class="header-section">
            <div class="row align-items-center">
                <div class="col-8">
                    <div class="d-flex align-items-center gap-3">
                        <img src="~/images/Tarsan-logo.png" alt="Tarsan Logo" style="height: 50px;" />
                        <div>
                            <h1 class="fw-black mb-0 h4" style="letter-spacing: -1px;">TARSAN</h1>
                            <p class="micro-text mb-0 fw-bold uppercase">Ante Mortem Muayene Formu</p>
                        </div>
                    </div>
                </div>
                <div class="col-4 text-end border-start border-dark ps-3">
                    <div class="micro-text">DOKÜMAN NO: <span class="text-dark">TE-FR-61</span></div>
                    <div class="micro-text">YAYIN TARİHİ: <span class="text-dark">01.12.2025</span></div>
                    <div class="micro-text">REV.NO: <span class="text-dark">00</span></div>
                    <div class="micro-text">REV.TARİHİ: <span class="text-dark">00</span></div>
                    <div class="micro-text">SAYFA NO: <span class="text-dark">01</span></div>
                </div>
            </div>
        </div>

        <!-- 1. Bölüm: Genel Bilgiler -->
        <div class="mb-4">
            <h6 class="section-title"><i class="bi bi-info-circle-fill me-2"></i>Genel Bilgiler</h6>
            <div class="row g-2">
                <div class="col-3">
                    <label class="custom-label">RAPOR TARİHİ</label>
                    <input type="date" asp-for="ReportDate" class="form-control custom-input" />
                </div>
                <div class="col-3">
                    <label class="custom-label">RAPOR NO</label>
                    <input type="text" asp-for="ReportNo" class="form-control custom-input" placeholder="Örn: 14022026" />
                </div>
                <div class="col-6">
                    <label class="custom-label">NUMUNE/PERSONEL ADI</label>
                    <select asp-for="ProductName" class="form-select custom-input">
                        <option value="">Lütfen seçim yapınız...</option>
                        <optgroup label="Ürünler">
                            <option>Dana Eti</option>
                            <option>Kuzu Eti</option>
                            <option>Dana Sucuk</option>
                            <option>Dana Salam</option>
                            <option>Dana Sosis</option>
                            <option>Kasap Köfte</option>
                            <option>İnegöl Köfte</option>
                            <option>Adana Kebap</option>
                            <option>Şeftali Kebap</option>
                            <option>Dana Döner</option>
                            <option>Piliç Döner</option>
                            <option>Dana Burger</option>
                        </optgroup>
                        <optgroup label="Personel">
                            <option>Yusuf Uslu</option>
                            <option>Asjad Aslan</option>
                            <option>Emre Uysal</option>
                            <option>Faisal Mahmood</option>
                            <option>Jafor Ahmed</option>
                            <option>Kadir Yeşil</option>
                            <option>Muhammed Salahutin</option>
                            <option>Necati Karakurt</option>
                            <option>Ramazan Göynük</option>
                            <option>Shehzad Shah</option>
                            <option>Umut Kenar </option>
                            <option>Mamurmur Rashid </option>
                        </optgroup>
                        <optgroup label="Ekipman">
                            <option>Kırmızı Tezgah</option>
                            <option>Beyaz Tezgah</option>
                            <option>Krom Tezgah</option>
                            <option>Bıçak</option>
                            <option>Mixer</option>
                            <option>Mavi Bant</option>
                            <option>Kıyma Makinesi</option>
                            <option>Dolum Makinesi</option>
                            <option>İçme Suyu</option>
                            <option>Kullanım Suyu</option>
                        </optgroup>
                    </select>
                </div>
                <div class="col-4">
                    <label class="custom-label">ANALİZ TİPİ</label>
                    <select asp-for="AnalysisType" class="form-select custom-input">
                        <option value="Mikrobiyolojik">Mikrobiyolojik</option>
                        <option value="Kimyasal">Kimyasal</option>
                    </select>
                </div>
                <div class="col-4">
                    <label class="custom-label">ALINDIĞI BÖLÜM</label>
                    <select asp-for="SamplingLocation" class="form-select custom-input">
                        <option value="İleri İşlem">İleri İşlem</option>
                        <option value="Kasaphane">Kasaphane</option>
                    </select>
                </div>
               
                <div class="col-4">
                    <label class="custom-label">ÜRETİM TARİHİ</label>
                    <input type="date" asp-for="ProductionDate" class="form-control custom-input" />
                </div>
                <div class="col-4">
                    <label class="custom-label">SON TÜKETİM TARİHİ</label>
                    <input type="date" asp-for="ExpiryDate" class="form-control custom-input" />
                </div>
                <div class="col-4">
                    <label class="custom-label">PARTİ NO</label>
                    <input type="text" asp-for="LotNo" class="form-control custom-input" />
                </div>
                <div class="col-4">
                    <label class="custom-label">GENEL SONUÇ</label>
                    <select asp-for="Sonuc" class="form-select custom-input fw-bold text-primary">
                        <option value="Uygun">Uygun</option>
                        <option value="Uygun Değil">Uygun Değil</option>
                    </select>
                </div>
            </div>
        </div>

        <!-- 2. Bölüm: Yapılan Analizler -->
        <div class="mb-4">
            <h6 class="section-title"><i class="bi bi-flask-fill me-2"></i>Yapılan Analizler</h6>
            <table class="analysis-table">
                <thead>
                    <tr>
                        <th style="width: 20%;">Analiz Adı</th>
                        <th style="width: 30%;">Yasal Limit</th>
                        <th style="width: 25%;">Ölçülen Sonuç</th>
                        <th style="width: 20%;">Onay</th>
                        <th style="width: 10%;">Evet</th>
                        <th style="width: 10%;">Hayır</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < Model.Analyses.Count; i++)
                    {
                        <tr class="analysis-row">
                            <input type="hidden" name="Analyses.Index" value="@i" />
                            <td>
                                @Model.Analyses[i].AnalysisName
                                <input type="hidden" asp-for="Analyses[i].AnalysisName" />
                            </td>

                            <td>
                                <select asp-for="Analyses[i].LimitValue" class="form-select custom-input">
                                    <option value="100 ml">M: 0 cfu/100ml</option>
                                    <option value="1 gr">M: 5*10²cfu/gr</option>
                                    <option value="1 gr">M: 1*10²cfu/gr</option>
                                    <option value="1 gr">M: 5*10⁶cfu/gr</option>
                                    <option value="25gr">25 Gr da bulunmayacak</option>
                                </select>
                            </td>

                            <td>
                                <input asp-for="Analyses[i].Result" class="form-control custom-input" />
                            </td>

                            <td>
                                <select asp-for="Analyses[i].Sonuc" class="form-select custom-input">
                                    <option value="Uygun">Uygun</option>
                                    <option value="Uygun Değil">Uygun Değil</option>
                                </select>
                            </td>

                            <td class="text-center">
                                <input type="radio" asp-for="Analyses[i].Positive" value="true" />
                            </td>

                            <td class="text-center">
                                <input type="radio" asp-for="Analyses[i].Positive" value="false" checked />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- 3. Bölüm: Onay -->
        <div class="row mt-4">
            <div class="col-12 text-end">
                <div class="d-inline-block text-center border-top border-dark pt-2 px-5">
                    <p class="micro-text mb-0">KONTROL EDEN / ONAYLAYAN</p>
                    <p class="small fw-bold mb-0">Kalite Güvence Birimi</p>
                </div>
            </div>
        </div>

        <!-- Kaydet Butonu -->
        <div class="text-center mt-4 d-print-none">
            <button type="submit" class="btn btn-dark px-5 py-2 fw-bold rounded-pill shadow">
                <i class="bi bi-check-circle-fill me-2"></i>SİSTEME KAYDET
            </button>
        </div>
    </div>
</form>


