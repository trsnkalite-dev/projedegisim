@model ResultAnalysisReportDto

<style>
    :root {
        --a4-width: 210mm;
        --a4-height: 297mm;
    }

    body {
        background-color: #f0f2f5;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .print-page {
        width: var(--a4-width);
        min-height: var(--a4-height);
        margin: 20px auto;
        background: white;
        padding: 15mm;
        box-shadow: 0 0 15px rgba(0,0,0,0.1);
        border: 1px solid #ddd;
        border-radius: 4px;
        position: relative;
    }

    @@media print {
        body {
            background: none;
            margin: 0;
            padding: 0;
        }

        .print-page {
            margin: 0;
            border: none;
            box-shadow: none;
            width: 100%;
            padding: 10mm;
        }

        .d-print-none {
            display: none !important;
        }
    }

    .header-table {
        width: 100%;
        border-bottom: 2px solid #000;
        margin-bottom: 20px;
        padding-bottom: 10px;
    }

    .doc-info {
        font-size: 0.7rem;
        line-height: 1.4;
        font-weight: bold;
        color: #333;
    }

    .info-label {
        font-size: 0.65rem;
        font-weight: 800;
        color: #666;
        text-transform: uppercase;
        margin-bottom: 2px;
    }

    .info-value {
        font-size: 0.9rem;
        font-weight: 600;
        color: #000;
        border-bottom: 1px solid #eee;
        padding-bottom: 4px;
        min-height: 1.2rem;
    }

    .findings-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 20px;
    }

        .findings-table th {
            background-color: #f8f9fa;
            border: 1px solid #000;
            padding: 8px;
            font-size: 0.8rem;
            text-transform: uppercase;
        }

        .findings-table td {
            border: 1px solid #000;
            padding: 6px 12px;
            font-size: 0.85rem;
        }

    .check-mark {
        font-family: Arial, sans-serif;
        font-weight: bold;
        font-size: 1.1rem;
    }

    .result-section {
        margin-top: 30px;
        border: 1px solid #000;
        padding: 15px;
        border-radius: 4px;
    }

    .status-box {
        display: inline-block;
        padding: 5px 15px;
        border: 2px solid #000;
        font-weight: 800;
        text-transform: uppercase;
    }
</style>



@if (Model == null)
{
    <div class="alert alert-danger">
        Rapor bulunamadı
    </div>
    return;
}

<div class="container d-print-none mt-4 mb-2" style="width: 210mm;">
    <div class="d-flex justify-content-between">
        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
            ← Listeye Dön
        </a>
        <button onclick="window.print()" class="btn btn-dark rounded-pill px-4">
            Yazdır
        </button>
    </div>
</div>

<div class="print-page">

    <!-- HEADER -->
    <table class="header-table">
        <tr>
            <td style="width: 15%;">
                <img src="/images/Tarsan-logo.png" style="height: 60px;" />
            </td>
            <td>
                <h2>TARSAN</h2>
                <small>Ürün Analiz Raporu</small>
            </td>
            <td class="text-end doc-info">
                <div>DOKÜMAN NO: TE-FR-61</div>
             
            </td>
        </tr>
    </table>

    <!-- GENEL BİLGİ -->
    <div class="row g-2 mb-3">

        <div class="col-4">
            <div class="info-label">Rapor No</div>
            <div class="info-value">@Model.ReportNo</div>
        </div>
        <div class="col-4">
            <div class="info-label">Rapor Tarihi</div>
            <div class="info-value">@Model.ReportDate.ToString("dd.MM.yyyy")</div>
        </div>
        <div class="col-4">
            <div class="info-label">Ürün</div>
            <div class="info-value">@Model.ProductName</div>
        </div>

        <div class="col-4">
            <div class="info-label">Analiz Tipi</div>
            <div class="info-value">@Model.AnalysisType</div>
        </div>

        <div class="col-4">
            <div class="info-label">Alındığı Bölüm</div>
            <div class="info-value">@Model.SamplingLocation</div>
        </div>

        <div class="col-4">
            <div class="info-label">Üretim Tarihi</div>
            <div class="info-value">@Model.ProductionDate?.ToString("dd.MM.yyyy")</div>
        </div>

        <div class="col-4">
            <div class="info-label">Son Tüketim</div>
            <div class="info-value">@Model.ExpiryDate?.ToString("dd.MM.yyyy")</div>
        </div>

        <div class="col-4">
            <div class="info-label">Lot No</div>
            <div class="info-value">@Model.LotNo</div>
        </div>

        <div class="col-4">
            <div class="info-label">Genel Sonuç</div>
            <div class="info-value fw-bold @(Model.Sonuc == "Uygun" ? "text-success" : "text-danger")">
                @Model.Sonuc
            </div>
        </div>

    </div>

    <!-- ANALİZ TABLOSU -->
    <table class="findings-table">
        <thead>
            <tr>
                <th>Analiz</th>
                <th>Limit</th>
                <th>Sonuç</th>
                <th>Uygunluk</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model.Analyses)
            {
                <tr>
                    <td>@item.AnalysisName</td>
                    <td class="text-center">@item.LimitValue</td>
                    <td class="text-center">@item.Result</td>
                    <td class="text-center fw-bold @(item.Sonuc == "Uygun" ? "text-success" : "text-danger")">
                        @item.Sonuc
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <!-- FOOTER -->
    <div class="result-section mt-4">
        <div class="d-flex justify-content-between">
            <div>
                <strong>Genel Sonuç:</strong>
                <span class="status-box @(Model.Sonuc == "Uygun" ? "text-success" : "text-danger")">
                    @Model.Sonuc
                </span>
            </div>

            <div class="text-center">
                <div style="border-top:1px solid #000; padding-top:5px;">
                    Kalite Güvence
                </div>
            </div>
        </div>
    </div>

</div>