@model List<ResultAnalysisReportDto>


@{
    ViewData["Title"] = "Analiz İstatistikleri";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div class="d-flex align-items-center gap-3">
            <i class="bi bi-graph-up fs-3"></i>
            <h2 class="mb-0">Analiz İstatistikleri</h2>
        </div>
        <div class="d-flex gap-3 align-items-center">
            <div class="d-flex align-items-center gap-2">
                <label class="mb-0 text-nowrap">Yıl Seçin:</label>
                <select id="yearSelector" class="form-select form-select-sm" style="width: 100px;">
                    @foreach (var year in Model.Select(x => x.ReportDate.Year).Distinct().OrderByDescending(y => y))
                    {
                        <option value="@year">@year</option>
                    }
                </select>
            </div>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-2"></i>Rapor Listesine Dön
            </a>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-white d-flex justify-content-between align-items-center">
                    <h5 class="card-title mb-0">Aylık Toplam Analiz Sayısı (<span id="selectedYearLabel"></span>)</h5>
                </div>
                <div class="card-body">
                    <canvas id="monthlyChart" height="150"></canvas>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-white">
                    <h5 class="card-title mb-0">Ürün Dağılımı (<span id="pieYearLabel">Tüm Yıllar</span>)</h5>
                </div>
                <div class="card-body">
                    <canvas id="productPieChart" height="300"></canvas>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-white d-flex justify-content-between align-items-center">
                    <h5 class="card-title mb-0">Ürün Bazlı Analiz Sonuçları</h5>
                    <div class="d-flex align-items-center gap-2">
                        <label class="mb-0 text-nowrap">Ürün Seçin:</label>
                        <select id="productSelector" class="form-select form-select-sm" style="width: 200px;">
                            <option value="">Tüm Ürünler</option>
                            @foreach (var product in Model.Select(x => x.ProductName).Distinct().OrderBy(p => p))
                            {
                                <option value="@product">@product</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-8">
                            <canvas id="productAnalysisChart" height="100"></canvas>
                        </div>
                        <div class="col-md-4">
                            <div id="productStats" class="p-3 bg-light rounded">
                                <h6>Analiz Özeti</h6>
                                <hr />
                                <div id="statsContent">
                                    Ürün seçiniz...
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-white">
                    <h5 class="card-title mb-0">Ürün Bazlı Aylık Analiz Trendi (<span id="trendYearLabel"></span>)</h5>
                </div>
                <div class="card-body">
                    <canvas id="productTrendChart" height="100"></canvas>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-white">
                    <h5 class="card-title mb-0">
                        Yıllara Göre Ürün Bazlı Analiz Sayısı (<span id="productYearLabel"></span>)
                    </h5>
                </div>
                <div class="card-body">
                    <canvas id="productYearChart" height="100"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const rawData = @Html.Raw(Json.Serialize(Model)) || [];
        const months = ["Ocak", "Şubat", "Mart", "Nisan", "Mayıs", "Haziran", "Temmuz", "Ağustos", "Eylül", "Ekim", "Kasım", "Aralık"];
        
        // Analiz isimlerini normalize etmek için bir liste
        const analysisNames = [
            "Salmonella", "Fekal Koliform", "Toplam Koliform", "E.Coli", 
            "E.coli O157", "L.monocytogenes", "TAMB(36°C)", "TAMB(22°C)", "Enterekok"
        ];

        let monthlyChart = null;
        let productTrendChart = null;
        let productPieChart = null;
        let productAnalysisChart = null;
        let productYearChart = null;

        let currentYear = null;
        let currentProduct = "";

        function updateCharts(year) {
            currentYear = parseInt(year);
            document.getElementById('selectedYearLabel').innerText = currentYear;
            document.getElementById('trendYearLabel').innerText = currentYear;
            const pieLabel = document.getElementById('pieYearLabel');
            if (pieLabel) pieLabel.innerText = currentYear;

            const filteredData = rawData.filter(item => {
                const date = new Date(item.reportDate || item.ReportDate);
                return date.getFullYear() === currentYear;
            });

            updateProductYearChart(currentYear);
            updateProductAnalysis(currentProduct);
            updateProductPieChart(filteredData);

            // 1. Monthly Total Chart
            const monthlyCounts = new Array(12).fill(0);
            filteredData.forEach(item => {
                const date = new Date(item.reportDate || item.ReportDate);
                monthlyCounts[date.getMonth()]++;
            });

            if (monthlyChart) monthlyChart.destroy();
            monthlyChart = new Chart(document.getElementById('monthlyChart'), {
                type: 'bar',
                data: {
                    labels: months,
                    datasets: [{
                        label: currentYear + ' Analiz Sayısı',
                        data: monthlyCounts,
                        backgroundColor: 'rgba(54, 162, 235, 0.6)',
                        borderColor: 'rgba(54, 162, 235, 1)',
                        borderWidth: 1
                    }]
                },
                options: {
                    responsive: true,
                    scales: { y: { beginAtZero: true, ticks: { stepSize: 1 } } }
                }
            });

            // 2. Product Trend Chart
            const productTrends = {};
            const uniqueProducts = [...new Set(filteredData.map(item => item.productName || item.ProductName).filter(Boolean))];
            
            uniqueProducts.forEach(prod => {
                productTrends[prod] = new Array(12).fill(0);
            });

            filteredData.forEach(item => {
                const date = new Date(item.reportDate || item.ReportDate);
                const prodName = item.productName || item.ProductName;
                productTrends[prodName][date.getMonth()]++;
            });

            const datasets = uniqueProducts.map((prod, index) => {
                const colors = ['#FF6384', '#36A2EB', '#FFCE56', '#4BC0C0', '#9966FF', '#FF9F40'];
                return {
                    label: prod,
                    data: productTrends[prod],
                    borderColor: colors[index % colors.length],
                    fill: false,
                    tension: 0.1
                };
            });

            if (productTrendChart) productTrendChart.destroy();
            productTrendChart = new Chart(document.getElementById('productTrendChart'), {
                type: 'line',
                data: {
                    labels: months,
                    datasets: datasets
                },
                options: {
                    responsive: true,
                    scales: { y: { beginAtZero: true, ticks: { stepSize: 1 } } }
                }
            });
        }

        function updateProductPieChart(data) {
            const productMap = {};
            data.forEach(item => {
                const prodName = item.productName || item.ProductName;
                if (prodName) {
                    productMap[prodName] = (productMap[prodName] || 0) + 1;
                }
            });

            const pieCtx = document.getElementById('productPieChart');
            if (!pieCtx) return;

            if (productPieChart) productPieChart.destroy();
            productPieChart = new Chart(pieCtx, {
                type: 'doughnut',
                data: {
                    labels: Object.keys(productMap),
                    datasets: [{
                        data: Object.values(productMap),
                        backgroundColor: ['#FF6384', '#36A2EB', '#FFCE56', '#4BC0C0', '#9966FF', '#FF9F40']
                    }]
                },
                options: {
                    responsive: true,
                    plugins: { legend: { position: 'bottom' } }
                }
            });
        }

        function updateProductAnalysis(productName) {
            currentProduct = productName;
            
            let filteredData = rawData;

            // Yıla göre filtrele
            if (currentYear) {
                filteredData = filteredData.filter(item => {
                    const date = new Date(item.reportDate || item.ReportDate);
                    return date.getFullYear() === currentYear;
                });
            }

            // Ürüne göre filtrele
            if (productName) {
                filteredData = filteredData.filter(item => (item.productName || item.ProductName) === productName);
            }

            const uygunCounts = [];
            const uygunDegilCounts = [];

            analysisNames.forEach(name => {
                let uygun = 0;
                let uygunDegil = 0;

                filteredData.forEach(report => {
                    const analyses = report.analyses || report.Analyses || [];
                    const item = analyses.find(a => (a.analysisName || a.AnalysisName) === name);
                    if (item) {
                        if ((item.sonuc || item.Sonuc) === "Uygun") uygun++;
                        else if ((item.sonuc || item.Sonuc) === "Uygun Değil") uygunDegil++;
                    }
                });

                uygunCounts.push(uygun);
                uygunDegilCounts.push(uygunDegil);
            });

            if (productAnalysisChart) productAnalysisChart.destroy();
            productAnalysisChart = new Chart(document.getElementById('productAnalysisChart'), {
                type: 'bar',
                data: {
                    labels: analysisNames,
                    datasets: [
                        {
                            label: 'Uygun',
                            data: uygunCounts,
                            backgroundColor: 'rgba(75, 192, 192, 0.6)',
                            borderColor: 'rgba(75, 192, 192, 1)',
                            borderWidth: 1
                        },
                        {
                            label: 'Uygun Değil',
                            data: uygunDegilCounts,
                            backgroundColor: 'rgba(255, 99, 132, 0.6)',
                            borderColor: 'rgba(255, 99, 132, 1)',
                            borderWidth: 1
                        }
                    ]
                },
                options: {
                    responsive: true,
                    scales: {
                        x: { stacked: true },
                        y: { stacked: true, beginAtZero: true, ticks: { stepSize: 1 } }
                    }
                }
            });

            // Update Stats Content
            const totalReports = filteredData.length;
            const overallUygun = filteredData.filter(item => (item.sonuc || item.Sonuc) === 'Uygun').length;
            const overallUygunDegil = filteredData.filter(item => (item.sonuc || item.Sonuc) === 'Uygun Değil').length;

            document.getElementById('statsContent').innerHTML = `
                <p><strong>Toplam Rapor:</strong> ${totalReports}</p>
                <p><strong>Genel Uygun:</strong> <span class="text-success">${overallUygun}</span></p>
                <p><strong>Genel Uygun Değil:</strong> <span class="text-danger">${overallUygunDegil}</span></p>
                <p class="small text-muted mt-2">* Seçilen yıla ve ürüne ait verilerdir.</p>
            `;
        }

        function updateProductYearChart(year) {
            const y = parseInt(year);
            const labelEl = document.getElementById('productYearLabel');
            if (labelEl) labelEl.innerText = y;

            const filteredData = rawData.filter(item => {
                const date = new Date(item.ReportDate || item.reportDate);
                return date.getFullYear() === y;
            });

            const productMap = {};
            filteredData.forEach(item => {
                const product = item.ProductName || item.productName;
                if (!product) return;
                productMap[product] = (productMap[product] || 0) + 1;
            });

            const labels = Object.keys(productMap);
            const values = Object.values(productMap);

            if (productYearChart) productYearChart.destroy();

            const ctx = document.getElementById('productYearChart');
            if (ctx) {
                productYearChart = new Chart(ctx, {
                    type: 'bar',
                    data: {
                        labels: labels,
                        datasets: [{
                            label: y + ' Ürün Bazlı Analiz',
                            data: values,
                            backgroundColor: 'rgba(153, 102, 255, 0.6)'
                        }]
                    },
                    options: {
                        responsive: true,
                        scales: { y: { beginAtZero: true, ticks: { stepSize: 1 } } }
                    }
                });
            }
        }

        // Initial Load
        const yearSelector = document.getElementById('yearSelector');
        if (yearSelector && yearSelector.value) {
            const initialYear = yearSelector.value;
            updateCharts(initialYear);
        } else {
            updateProductAnalysis("");
            updateProductPieChart(rawData);
        }

        // Year Selector Change
        if (yearSelector) {
            yearSelector.addEventListener('change', (e) => {
                updateCharts(e.target.value);
            });
        }

        // Product Selector Change
        const productSelector = document.getElementById('productSelector');
        if (productSelector) {
            productSelector.addEventListener('change', (e) => {
                updateProductAnalysis(e.target.value);
            });
        }
    </script>
}
