@model KaliteWeb.UI.Models.ProductionLots.CreateProductionLotViewModel
@{
    ViewData["Title"] = "Alt Lot Oluştur";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">

    <div class="card shadow-sm">

        <div class="card-header">
            <h4 class="mb-0">
                Alt Lot Oluştur
            </h4>
        </div>

        <div class="card-body">

            <form asp-action="Create"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>


                <!-- ================================================= -->
                <!-- ÜRETİM -->
                <!-- ================================================= -->

                <div class="card mb-4">

                    <div class="card-header">
                        <strong>Üretim Bilgileri</strong>
                    </div>

                    <div class="card-body">

                        <input type="hidden"
                               asp-for="ProductionId" />

                        <div class="row">

                            <div class="col-md-4">

                                <label class="form-label">
                                    Üretim No
                                </label>

                                <input asp-for="ProductionNo"
                                       class="form-control"
                                       readonly />

                            </div>


                            <div class="col-md-4">

                                <label class="form-label">
                                    Ana Lot
                                </label>

                                <input asp-for="MainLotNo"
                                       class="form-control"
                                       readonly />

                            </div>


                            <div class="col-md-4">

                                <label class="form-label">
                                    Üretim ID
                                </label>

                                <input value="@Model.ProductionId"
                                       class="form-control"
                                       readonly />

                            </div>

                        </div>

                    </div>

                </div>


                <!-- ================================================= -->
                <!-- ALT LOT -->
                <!-- ================================================= -->

                <div class="card mb-4">

                    <div class="card-header">
                        <strong>Alt Lot Bilgileri</strong>
                    </div>

                    <div class="card-body">

                        <div class="row">

                            <div class="col-md-4">

                                <div class="form-check mb-3">

                                    <input asp-for="ManualSubLotNo"
                                           class="form-check-input"
                                           id="manualSubLotNo" />

                                    <label class="form-check-label"
                                           for="manualSubLotNo">

                                        Alt Lot No manuel gir

                                    </label>

                                </div>

                            </div>

                        </div>


                        <div class="row">

                            <div class="col-md-6">

                                <label class="form-label">
                                    Alt Lot No
                                </label>

                                <input asp-for="SubLotNo"
                                       id="subLotNo"
                                       class="form-control"
                                       placeholder="Otomatik oluşturulacak" />

                                <small class="text-muted">
                                    Manuel seçim yapılmazsa sistem
                                    otomatik alt lot numarası oluşturur.
                                </small>

                            </div>


                            <div class="col-md-6">

                                <label class="form-label">
                                    Miktar (kg)
                                </label>

                                <input asp-for="Quantity"
                                       class="form-control"
                                       type="number"
                                       step="0.001"
                                       min="0.001" />

                            </div>

                        </div>

                    </div>

                </div>


                <!-- ================================================= -->
                <!-- DEPO -->
                <!-- ================================================= -->

                <div class="col-md-6">

                    <label asp-for="DepoId" class="form-label">
                        Depo
                    </label>

                    <select asp-for="DepoId"
                            class="form-select">

                        <option value="">
                            -- Depo Seçiniz --
                        </option>

                        @foreach (var depo in Model.Depolar)
                        {
                            <option value="@depo.Id">
                                @depo.DepoAdi
                            </option>
                        }

                    </select>

                    <span asp-validation-for="DepoId"
                          class="text-danger">
                    </span>

                </div>

                <!-- ================================================= -->
                <!-- AÇIKLAMA -->
                <!-- ================================================= -->

                <div class="mb-4">

                    <label class="form-label">
                        Açıklama
                    </label>

                    <textarea asp-for="Description"
                              class="form-control"
                              rows="3">
                    </textarea>

                </div>


                <!-- ================================================= -->
                <!-- BUTONLAR -->
                <!-- ================================================= -->

                <div class="d-flex justify-content-between">

                    <a asp-controller="Production"
                       asp-action="Index"
                       class="btn btn-secondary">

                        Vazgeç

                    </a>

                    <button type="submit"
                            class="btn btn-primary">

                        <i class="bi bi-plus-circle"></i>
                        Alt Lot Oluştur

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>

        document
            .getElementById("manualSubLotNo")
            .addEventListener("change", function () {

                const input =
                    document.getElementById("subLotNo");

                if (this.checked) {

                    input.disabled = false;
                    input.placeholder =
                        "Alt Lot No giriniz";

                } else {

                    input.value = "";
                    input.disabled = true;
                    input.placeholder =
                        "Sistem otomatik oluşturacak";
                }

            });

    </script>
}