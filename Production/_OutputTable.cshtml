@model List<Kalite.Contracts.Production.Responses.ProductionLotDto>

@{
    var items = Model ?? new List<Kalite.Contracts.Production.Responses.ProductionLotDto>();
}

<div class="card shadow-sm border-0">
    <div class="card-header bg-light d-flex justify-content-between align-items-center py-2">
        <strong class="text-dark">
            <i class="bi bi-box-fill text-primary me-1"></i> Oluşan Mamuller (Alt Lotlar)
        </strong>
        <span class="badge bg-secondary">@items.Count Parti</span>
    </div>

    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-bordered table-hover mb-0 align-middle text-nowrap">
                <thead class="table-light">
                    <tr>
                        <th style="width: 180px;">Lot No</th>
                        <th>Mamul Adı</th>
                        <th style="width: 80px;" class="text-center">Birim</th>
                        <th style="width: 130px;" class="text-end">Miktar</th>
                        <th style="width: 140px;" class="text-center">Üretim Tarihi</th>
                        <th style="width: 160px;" class="text-center">İşlemler</th>
                    </tr>
                </thead>

                <tbody>
                    @if (!items.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">
                                <i class="bi bi-inbox fs-4 d-block mb-1 text-secondary"></i>
                                Henüz oluşan mamul bulunmuyor. Lütfen "+ Yeni Mamul / Lot Girişi" butonundan üretim miktarını giriniz.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in items)
                        {
                            <tr>
                                <td>
                                    <span class="badge bg-dark font-monospace fs-6">
                                        @item.LotNo
                                    </span>
                                </td>

                                <td class="fw-semibold">
                                    @item.StockName
                                </td>

                                <td class="text-center">
                                    <span class="badge bg-light text-dark border">
                                        @(string.IsNullOrWhiteSpace(item.Unit) ? "KG" : item.Unit)
                                    </span>
                                </td>

                                <td class="text-end fw-bold text-success">
                                    @item.Quantity.ToString("N3")
                                </td>

                                <td class="text-center small text-muted">
                                    @item.ProductionDate.ToString("dd.MM.yyyy")
                                </td>

                                <td class="text-center">
                                    <div class="btn-group btn-group-sm" role="group">
                                        <a asp-controller="ProductionPackaging"
                                               asp-action="Create"
                                               asp-route-productionLotId="@item.Id"
                                               class="btn btn-warning fw-semibold shadow-sm"
                                               title="Koliye Paketle">
                                            <i class="bi bi-box-seam me-1"></i> Paketle
                                        </a>

                                        <button type="button"
                                                class="btn btn-outline-secondary labelBtn"
                                                data-id="@item.Id"
                                                title="Parti Etiketi Bas">
                                            <i class="bi bi-printer"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>

                @if (items.Any())
                {
                    <tfoot class="table-light">
                        <tr class="fw-bold">
                            <th colspan="3" class="text-end">Toplam:</th>
                            <th class="text-end text-success">@items.Sum(x => x.Quantity).ToString("N3")</th>
                            <th colspan="2"></th>
                        </tr>
                    </tfoot>
                }
            </table>
        </div>
    </div>
</div>