@model List<Kalite.Contracts.Production.Responses.ProductionConsumptionDetailDto>

<div class="card shadow-sm">

    <div class="card-header bg-light">

        <strong>

            <i class="bi bi-box-seam"></i>

            Hammadde Tüketimi

        </strong>

    </div>

    <div class="card-body p-0">

        <table class="table table-hover table-bordered mb-0">

            <thead class="table-light">

                <tr>

                    <th width="120">Kod</th>

                    <th>Hammadde</th>

                    <th width="170">Lot</th>

                    <th width="80">Birim</th>

                    <th width="120" class="text-end">

                        Kullanılan

                    </th>

                </tr>

            </thead>

            <tbody>

                @if (!Model.Any())
                {
                    <tr>

                        <td colspan="5"
                            class="text-center text-muted py-4">

                            Hammadde bulunamadı.

                        </td>

                    </tr>
                }

                @foreach (var item in Model)
                {
                    <tr>

                        <td>

                            @item.StockCode

                        </td>

                        <td>

                            @item.StockName

                        </td>

                        <td>

                            <span class="badge bg-secondary">

                                @item.LotNo

                            </span>

                        </td>

                        <td>

                            @item.Unit

                        </td>

                        <td class="text-end">

                            @item.Quantity.ToString("N3")

                        </td>

                    </tr>
                }

            </tbody>

            @if (Model.Any())
            {
                <tfoot>

                    <tr>

                        <th colspan="4"
                            class="text-end">

                            Toplam

                        </th>

                        <th class="text-end">

                            @Model.Sum(x => x.Quantity).ToString("N3")

                        </th>

                    </tr>

                </tfoot>
            }

        </table>

    </div>

</div>